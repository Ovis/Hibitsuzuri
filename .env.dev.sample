# compose-dev-sample.yml用。.env.devへコピーし、--env-file .env.devで指定する。
HIBITSUZURI_IMAGE=hibitsuzuri:local
PUBLIC_ORIGIN=https://hibitsuzuri-dev.example.com

# アプリのポートを直接公開せず、プロキシ経由に限定する配置で選択する。
# IPを限定する場合はKnownProxiesへ変更し、ComposeにKnownProxiesの接続元IPを追加する。
REVERSE_PROXY_MODE=DeploymentManaged
HIBITSUZURI_TIMEZONE=Asia/Tokyo

# 配布イメージで稼働する環境と保存先を分ける。先に作成しAPP_UID・APP_GIDの読み書きを許可する。
DATA_DIRECTORY=/opt/docker/Hibitsuzuri-dev/data
BACKUP_DIRECTORY=/opt/docker/Hibitsuzuri-dev/backups
LOG_DIRECTORY=/opt/docker/Hibitsuzuri-dev/logs
APP_UID=1654
APP_GID=1654
APP_MEMORY=2g
APP_CPUS=2
