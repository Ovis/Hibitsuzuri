@model Hibitsuzuri.Web.Models.NewPasswordModel
@{
    ViewData["Title"] = "復旧用パスワードの設定";
}

<div class="page-heading"><h1>新しいパスワードを設定</h1></div>
<section class="paper settings-panel">
    <p>設定すると全端末がログアウトされ、登録済みPasskeyと旧リカバリーコードが無効になります。新しいコードを保存した後、ログインし直してください。</p>
    <form method="post" action="/auth/recovery/password" class="account-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="notice" role="alert"></div>
        <label asp-for="Password">新しいパスワード（12～128文字）<input asp-for="Password" autocomplete="new-password" required /></label>
        <label asp-for="PasswordConfirmation">パスワードの確認<input asp-for="PasswordConfirmation" autocomplete="new-password" required /></label>
        <button type="submit" class="button primary">認証情報を更新して復旧</button>
    </form>
</section>
