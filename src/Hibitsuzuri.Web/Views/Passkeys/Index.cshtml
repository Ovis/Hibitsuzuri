@using Microsoft.AspNetCore.WebUtilities
@model IList<Microsoft.AspNetCore.Identity.UserPasskeyInfo>
@{
    ViewData["Title"] = "Passkey管理";
}

<div class="page-heading"><h1>Passkey管理</h1></div>
<section class="paper settings-panel">
    <p>端末の指紋・顔・PINなどの本人確認でログインできます。最大20個まで登録できます。追加・削除には直近10分以内の本人確認が必要です。</p>
    <a href="/account/reauthenticate?returnUrl=/account/passkeys">本人確認する</a>

    <form class="account-form passkey-form" data-purpose="register">
        @Html.AntiForgeryToken()
        <label>表示名（任意）<input name="Name" maxlength="100" placeholder="例：自宅のPC" aria-describedby="passkey-name-help" /></label>
        <p id="passkey-name-help" class="muted">空欄の場合は、登録に使ったサービスなどの名前を自動で付けます。判別できない場合は登録日付きの名前になります。登録後も変更できます。</p>
        <button type="submit" class="button primary">Passkeyを追加</button>
        <p role="status" class="passkey-status"></p>
    </form>

    @if (Model.Count == 0)
    {
        <p>Passkeyはまだ登録されていません。</p>
    }

    @foreach (var key in Model)
    {
        <div id="key-@WebEncoders.Base64UrlEncode(key.CredentialId)" class="credential-row">
            <p>登録日：@key.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</p>
            <form method="post" action="/account/passkeys/rename" class="account-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@WebEncoders.Base64UrlEncode(key.CredentialId)" />
                <label>表示名<input name="name" value="@key.Name" maxlength="100" required /></label>
                <button class="button" type="submit">名前を変更</button>
            </form>

            <form method="post" action="/account/passkeys/delete" class="account-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@WebEncoders.Base64UrlEncode(key.CredentialId)" />
                <label class="check-label"><input type="checkbox" name="confirmed" value="true" required /> 「@key.Name」を削除する</label>
                <button class="button" type="submit">削除</button>
            </form>
        </div>
    }
</section>

<script src="~/js/passkeys.js" asp-append-version="true" defer></script>
