@model Hibitsuzuri.Web.Diary.Notebook
@{
    ViewData["Title"] = "日記帳の設定";
    ViewData["Navigation"] = "books";
}

<header class="page-header">
    <h1>日記帳の設定</h1>
</header>

<form class="account-form paper" method="post" action="/books/@Model.Id">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="notice" role="alert"></div>
    <input type="hidden" name="version" value="@Model.Version" />

    <label for="name">日記帳名</label>
    <input id="name" name="name" value="@Model.Name" required maxlength="200" />

    <label for="template">新規日記のテンプレート（Markdown）</label>
    <p class="muted">100,000文字以内。保存済みの日記や下書きには適用しません。</p>
    <textarea id="template" name="template" rows="14">
@Model.Template</textarea>

    <div class="actions">
        <button class="button primary" type="submit">保存する</button>
        <a href="/books">戻る</a>
    </div>
</form>

<section class="paper spacer">
    <h2>タスクの停止</h2>
    <p>停止中は閲覧のみになります。再開時は停止期間に到来した未操作の繰り返しをスキップし、以前の未完了や操作済みの回は残します。</p>
    <form method="post" action="/tasks/pause/@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" name="version" value="@Model.Version" />
        <input type="hidden" name="paused" value="@((Model.TasksPausedOn is null).ToString().ToLowerInvariant())" />
        <button type="submit">@(Model.TasksPausedOn is null ? "タスクを停止する" : "タスクを再開する")</button>
    </form>
</section>

<section class="paper settings-panel spacer">
    <h2>@(Model.Archived ? "アーカイブを解除" : "日記帳をアーカイブ")</h2>
    <p>アーカイブした日記帳は通常の選択肢から外れます。日記帳一覧から開いて閲覧・編集できます。</p>
    <form method="post" action="/books/@Model.Id/state" class="account-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="version" value="@Model.Version" />
        <input type="hidden" name="operation" value="@(Model.Archived ? "unarchive" : "archive")" />
        @if (!Model.Archived)
        {
            <label class="check-label"><input type="checkbox" name="pauseTasks" value="true" checked /> タスクも停止する</label>
        }
        <label class="check-label"><input type="checkbox" name="confirmed" value="true" required /> この日記帳の状態を変更する</label>
        <button class="button" type="submit">@(Model.Archived ? "アーカイブを解除する" : "アーカイブする")</button>
    </form>
</section>

<details class="paper settings-panel spacer">
    <summary>日記帳を削除する</summary>
    <p>「@Model.Name」とその記録をゴミ箱へ移します。タスク・通知も停止します。日記帳一覧のゴミ箱から復元できます。</p>
    <form method="post" action="/books/@Model.Id/state" class="account-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="version" value="@Model.Version" />
        <input type="hidden" name="operation" value="delete" />
        <label class="check-label"><input type="checkbox" name="confirmed" value="true" required /> 日記帳とその記録をゴミ箱へ移す</label>
        <button class="button danger" type="submit">日記帳を削除する</button>
    </form>
</details>
