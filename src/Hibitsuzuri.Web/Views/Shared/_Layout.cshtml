@using System.Security.Claims
@{
    var preferenceOwner = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var preferenceKey = preferenceOwner is null
        ? "hibitsuzuri.appearance.anonymous"
        : $"hibitsuzuri.appearance.user.{preferenceOwner}";
    var currentPage = ViewData["Navigation"] as string;
}
<!DOCTYPE html>
<html lang="ja" data-theme="light" data-color="neutral" data-appearance-key="@preferenceKey">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Hibitsuzuri</title>
    <link rel="icon" href="~/images/book.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/appearance.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <div class="shell">
        <header class="sidebar">
            <div class="brand-block">
                <a class="brand" href="/" aria-label="Hibitsuzuri ホーム">
                    <svg class="brand-mark" viewBox="0 0 32 36" aria-hidden="true">
                        <path d="M5 4h18a3 3 0 0 1 3 3v25H8a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Z" />
                        <path d="M9 4v23M5 28h21M14 12h7M14 17h5" />
                    </svg>
                    <span class="brand-name">Hibitsuzuri</span>
                </a>
                <p class="brand-sub">日々を、綴る。</p>
            </div>
            <nav class="navigation" aria-label="メインメニュー">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/" aria-current="@(currentPage == "home" ? "page" : null)">ホーム</a>
                    <a href="/settings/appearance" aria-current="@(currentPage == "appearance" ? "page" : null)">表示設定</a>
                    <a href="/account" aria-current="@(currentPage == "account" ? "page" : null)">アカウント</a>
                    <form method="post" action="/auth/logout">
                        @Html.AntiForgeryToken()
                        <button class="nav-button" type="submit">ログアウト</button>
                    </form>
                }
                else
                {
                    <a href="/auth/login">ログイン</a>
                }
            </nav>
        </header>
        <main id="main" class="main" tabindex="-1">
            <div class="content">@RenderBody()</div>
        </main>
    </div>
</body>
</html>
