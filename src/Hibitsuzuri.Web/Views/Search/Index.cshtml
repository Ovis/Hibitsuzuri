@model Hibitsuzuri.Web.Diary.SearchPage
@using Hibitsuzuri.Web.Diary
@{
    ViewData["Title"] = "検索";
    ViewData["Navigation"] = "search";
    string PageUrl(int page) => $"/search?keyword={Uri.EscapeDataString(Model.Keyword)}&bookId={Model.BookId}&start={Model.Start:yyyy-MM-dd}&end={Model.End:yyyy-MM-dd}&page={page}";
}
<header class="page-header"><p class="eyebrow">SEARCH</p><h1>日記を検索</h1></header>
<form method="get" class="paper form-stack">
    <label>検索語 <input name="keyword" value="@Model.Keyword" maxlength="200" required /></label>
    <div class="day-navigation">
        <label>開始日 <input type="date" name="start" value="@Model.Start?.ToString("yyyy-MM-dd")" /></label>
        <label>終了日 <input type="date" name="end" value="@Model.End?.ToString("yyyy-MM-dd")" /></label>
        <label>日記帳
            <select name="bookId">
                <option value="">すべての日記帳</option>
                @foreach (var book in Model.Books)
                {
                    <option value="@book.Id" selected="@(book.Id == Model.BookId)">@book.Name</option>
                }
            </select>
        </label>
    </div>
    <button class="primary" type="submit">検索</button>
    <p class="muted">表示される本文の部分一致で検索します。英数字の全角・半角、大文字・小文字は区別しません。</p>
</form>
@if (Model.Error is not null)
{
    <p class="notice" role="alert">@Model.Error</p>
}
else if (Model.Keyword.Length > 0)
{
    <p class="muted">日付の新しい順・1ページ50件</p>
    @if (Model.Entries.Count == 0)
    {
        <p class="paper">一致する日記はありません。</p>
    }
    @foreach (var entry in Model.Entries)
    {
        <article class="paper record-card spacer">
            <p class="eyebrow">@Model.Books.Single(x => x.Id == entry.NotebookId).Name</p>
            <h2><a href="/diary/@entry.NotebookId/@entry.EntryDate.ToString("yyyy-MM-dd")">@entry.EntryDate.ToString("yyyy年M月d日（ddd）")</a></h2>
            <p class="search-snippet">@Html.Raw(DiarySearch.Snippet(entry.PlainText, Model.Keyword))</p>
        </article>
    }
    <nav class="day-navigation" aria-label="検索結果のページ">
        @if (Model.Page > 1)
        {
            <a href="@PageUrl(Model.Page - 1)">前の50件</a>
        }
        @if (Model.HasNext)
        {
            <a href="@PageUrl(Model.Page + 1)">次の50件</a>
        }
    </nav>
}
