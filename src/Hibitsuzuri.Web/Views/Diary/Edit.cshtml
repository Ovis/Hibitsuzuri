@using System.Security.Claims
@model Hibitsuzuri.Web.Diary.DiaryPage
@inject Hibitsuzuri.Web.Images.ImageStore Images
@{
    ViewData["Title"] = Model.Day + " の編集";
    ViewData["Navigation"] = "home";
}

<form id="diary-editor" method="post" action="/api/diary/@Model.Book.Id/@Model.Day/save"
      data-owner="@User.FindFirstValue(ClaimTypes.NameIdentifier)" data-book="@Model.Book.Id" data-date="@Model.Day"
      data-return="@Model.Path" data-version="@Model.Entry?.Version" data-new="@(Model.Entry is null ? "true" : "false")">
    @Html.AntiForgeryToken()
    <header class="diary-heading page-header">
        <div>
            <p class="eyebrow">@Model.Book.Name ／ 編集</p>
            <h1>@Model.Date.ToString("yyyy年M月d日（ddd）")</h1>
        </div>
        <div class="actions">
            <button id="cancel-edit" type="button">キャンセル</button>
            <button id="save-entry" class="button primary" type="submit" disabled>保存する</button>
        </div>
    </header>

    <noscript><p class="notice">日記の編集にはJavaScriptが必要です。</p></noscript>
    <p id="editor-notice" class="notice" role="status" hidden></p>

    <section id="draft-candidates" class="settings-panel" hidden>
        <h2>このブラウザの下書き</h2>
        <p>保存日時を確認して復元してください。別の画面の入力と混ざらないよう、復元内容は新しい下書きとして扱います。</p>
        <div id="draft-list"></div>
        <button id="skip-drafts" type="button">候補を閉じて編集する</button>
    </section>

    <section id="conflict" class="settings-panel" hidden>
        <h2>最新版との比較</h2>
        <p>入力中の本文は下の編集欄に残っています。自動では統合しません。</p>
        <label for="latest-content">サーバーの最新版</label>
        <textarea id="latest-content" rows="8" readonly></textarea>
        <div class="actions">
            <button id="use-latest" type="button">最新版を編集欄に読み込む</button>
            <button id="keep-mine" type="button">比較を終えて入力中の本文を採用</button>
        </div>
        <p class="muted">採用後も「保存する」を押すまで日記は変わりません。</p>
    </section>

    <section class="paper editor-paper">
        <div class="editor-tabs" role="group" aria-label="編集とプレビュー">
            <button type="button" data-editor-tab="edit" aria-pressed="true">編集</button>
            <button type="button" data-editor-tab="preview" aria-pressed="false">プレビュー</button>
        </div>

        <div class="editor-toolbar" role="group" aria-label="Markdown書式">
            <button type="button" data-format="bold" aria-label="太字"><b>B</b></button>
            <button type="button" data-format="italic" aria-label="斜体"><i>I</i></button>
            <button type="button" data-format="heading">見出し</button>
            <button type="button" data-format="list">箇条書き</button>
            <button type="button" data-format="link">リンク</button>
        </div>

        <div class="editor-grid" data-active-pane="edit">
            <div class="editor-pane input-pane">
                <label class="pane-label" for="diary-content">Markdown</label>
                @* textarea直後の改行はHTMLパーサーが除去するため、本文先頭の改行とは分ける。 *@
                <textarea id="diary-content" spellcheck="true" placeholder="日記の本文を入力" disabled>
@Model.Entry?.Content</textarea>
            </div>
            <section class="editor-pane preview-pane" aria-label="プレビュー">
                <h2 class="pane-label">プレビュー</h2>
                <div id="diary-preview" class="prose">@Html.Raw(Model.Html)</div>
            </section>
        </div>

        <div class="editor-status">
            <span id="draft-status" role="status">下書きはこのブラウザに保存されます。</span>
            <span id="word-count"></span>
        </div>
    </section>

    <section class="settings-panel">
        <h2>添付画像</h2>
        <label for="image-files">画像を追加</label>
        <input id="image-files" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
        <p class="muted">JPEG・PNG・WebP・GIF、1枚20MiB以内。HEIC/HEIFはJPEG等へ変換してください。<a href="/settings/images" target="_blank" rel="noopener noreferrer">保存設定</a></p>
        <p id="image-status" role="status">画像を確認しています。</p>
        <div id="image-list" class="attachment-list"></div>
        <p class="muted">下書きだけの画像は最後の下書き保存から30日間保持します。本文の下書きには期限がありません。日記・履歴に残る画像は保持されます。</p>
    </section>

    <details id="history" class="settings-panel">
        <summary>編集履歴（過去 @Model.Revisions.Count 版）</summary>
        <p class="muted">読み込み後に確認し、明示保存すると現行版に反映されます。</p>
        @foreach (var revision in Model.Revisions)
        {
            <div class="book-row">
                <span>@DateTimeOffset.FromUnixTimeMilliseconds(revision.UpdatedAt).ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</span>
                <button type="button" data-revision="@revision.Id">編集欄に読み込む</button>
            </div>
            <textarea id="revision-@revision.Id" hidden>
@revision.Content</textarea>
            <details>
                <summary>この版の本文・画像を見る</summary>
                <article class="prose">@Html.Raw(await Images.RenderAsync(Model.Book.UserId, revision.Content))</article>
            </details>
        }
    </details>

    <textarea id="book-template" hidden>
@Model.Book.Template</textarea>
</form>

<script src="~/js/diary-editor.js" asp-append-version="true" type="module"></script>
