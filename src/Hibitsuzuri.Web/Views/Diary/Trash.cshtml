@model Hibitsuzuri.Web.Diary.DiaryTrash
@{
    ViewData["Title"] = "ゴミ箱";
    ViewData["Navigation"] = "home";
}
<header class="page-header">
    <p class="eyebrow">@Model.Book.Name</p>
    <h1>ゴミ箱（@Model.Entries.Count 件）</h1>
    <a href="/diary/@Model.Book.Id">日記に戻る</a>
</header>
<section class="paper">
    @if (Model.Entries.Count == 0)
    {
        <p>ゴミ箱は空です。</p>
    }
    @foreach (var entry in Model.Entries)
    {
        <div class="book-row">
            <a href="/diary/@Model.Book.Id/@entry.EntryDate.ToString("yyyy-MM-dd")">@entry.EntryDate.ToString("yyyy年M月d日")</a>
            <div class="actions">
                <form method="post" action="/diary/@Model.Book.Id/@entry.EntryDate.ToString("yyyy-MM-dd")/trash">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="version" value="@entry.Version" />
                    <button name="action" value="restore">復元する</button>
                </form>
                <form method="post" action="/diary/@Model.Book.Id/@entry.EntryDate.ToString("yyyy-MM-dd")/trash" data-confirm="この日記と編集履歴を完全削除します。元に戻せません。削除しますか？">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="version" value="@entry.Version" />
                    <button name="action" value="purge">完全削除</button>
                </form>
            </div>
        </div>
    }
</section>
@if (Model.Entries.Count > 0)
{
    <details class="settings-panel">
        <summary>この日記帳のゴミ箱を空にする</summary>
        <p>「@Model.Book.Name」の @Model.Entries.Count 件と編集履歴を完全削除します。元に戻せません。</p>
        <form method="post" action="/diary/@Model.Book.Id/trash/empty" class="account-form" data-confirm="表示した日記帳のゴミ箱を空にします。よろしいですか？">
            @Html.AntiForgeryToken()
            <input type="hidden" name="snapshot" value="@Model.Snapshot" />
            <input type="hidden" name="count" value="@Model.Entries.Count" />
            <label for="confirm-name">確認のため日記帳名を入力</label>
            <input id="confirm-name" name="name" required autocomplete="off" />
            <button type="submit">@Model.Entries.Count 件を完全削除する</button>
        </form>
    </details>
}
<script src="~/js/diary-navigation.js" asp-append-version="true" defer></script>
