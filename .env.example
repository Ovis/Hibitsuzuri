# .envへコピーして配置先に合わせる。開発機ではcompose.ymlからローカルビルドする。
# 配布イメージを使用する場合は、固定タグまたはダイジェストに置き換える。
HIBITSUZURI_IMAGE=hibitsuzuri:local
PUBLIC_ORIGIN=https://hibitsuzuri.example.com
# 環境固有のTraefik用compose.ymlだけで使用する。
DOMAIN_BASE=example.com

# アプリのポートを直接公開せず、プロキシ経由に限定する配置で選択する。
# IPを限定する場合はKnownProxiesへ変更し、ComposeにKnownProxiesの接続元IPを追加する。
REVERSE_PROXY_MODE=DeploymentManaged
HIBITSUZURI_TIMEZONE=Asia/Tokyo
# 初回管理者の登録に使用する秘密。登録前に推測困難な値を設定する。
HIBITSUZURI_SETUP_CODE=

# 先にホスト側で作成し、APP_UID・APP_GIDの読み書きを許可する。
DATA_DIRECTORY=/opt/Docker/Hibitsuzuri/data
BACKUP_DIRECTORY=/opt/Docker/Hibitsuzuri/backups
LOG_DIRECTORY=/opt/Docker/Hibitsuzuri/logs
APP_UID=1654
APP_GID=1654
APP_MEMORY=2g
APP_CPUS=2
